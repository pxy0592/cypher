# 版本控制
.git
.gitignore

# 运行时数据：注册表、上传临时文件、默认部署目录
data

# 本机已部署的应用目录（内含 .env 密钥）。
# 换成你自己的部署目录即可；只是减少上下文体积，源码 COPY 白名单并不包含它们。
casdoor
smartq

# 依赖与构建产物（本项目不需要，出现即为误提交）
node_modules
npm-debug.log*

# 本地环境变量：可能含 CYPHER_TOKEN，绝不能进构建上下文
.env
.env.*

# 镜像归档与日志，避免几 GB 的构建上下文
*.tar
*.tar.gz
*.tgz
*.tar.zst
*.log

# 容器化相关的元文件，构建时不需要进镜像
Dockerfile
.dockerignore
docker-compose.y*ml
compose.y*ml

# 编辑器与系统杂项
.vscode
.idea
.DS_Store
*.swp
