# 复制为 .env 后使用：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# 必填。生成方式：openssl rand -hex 32
CYPHER_TOKEN=

# 宿主机数据目录。容器内路径与它保持一致，因此不要改成 /data 之类的容器内路径。
# 默认 /srv/cypher，不存在时由 Docker 以 root 创建
CYPHER_HOME=/srv/cypher

# 对外端口与监听地址
CYPHER_PORT=3000
# 只给本机反向代理用时改成 127.0.0.1
CYPHER_BIND=0.0.0.0

# 单个镜像归档的上限（MB）
CYPHER_MAX_UPLOAD_MB=4096

# Cypher 容器自身的资源上限。构建与拉取由宿主机守护进程执行，不受此限制。
CYPHER_MEM_LIMIT=1g
CYPHER_CPUS=2

# 时区，影响日志时间与容器内 date
TZ=Asia/Shanghai
